# Security Context Service configuration.
# Copy this file to `.env` and fill in values. `.env` is gitignored, so never commit real keys.
# On Kubernetes these come from deploy/k8s/configmap.yaml and the security-context-secrets Secret.

# ---------------------------------------------------------------------------
# API keys
# ---------------------------------------------------------------------------

# NVD API key (free). Raises the NVD rate limit from 5 to 50 requests per 30 seconds.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Context7 API key, from your Context7 account dashboard: https://context7.com
# Without it, Context7 breaking-change notes are skipped.
CONTEXT7_API_KEY=

# Optional GitHub token, only used to list the OWASP cheat sheets during a sync.
GITHUB_TOKEN=

# Enables POST /admin/sync (used by the Kubernetes CronJobs). Leave empty to disable.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Note: OSV.dev, MITRE CWE, OWASP, CISA KEV, Docker Hub and endoflife.date need no key.

# ---------------------------------------------------------------------------
# Online lookups (NVD, OSV.dev, Context7 are queried on demand and cached in SQLite)
# ---------------------------------------------------------------------------

# Set to false to answer only from the local database (no network calls at request time).
ONLINE_LOOKUPS=true

# lazy = fetch CVEs on demand (local/CI); full = keep a full local NVD copy (Kubernetes).
NVD_SYNC_MODE=lazy

NVD_CACHE_DAYS=7
OSV_CACHE_HOURS=24
# Docker Hub image lines (newer release lines of an image and their base OS).
REGISTRY_CACHE_HOURS=24
# PyPI / npm package metadata for the trial plan (companion and parent upgrades).
PACKAGES_CACHE_HOURS=24
# endoflife.date support dates.
LIFECYCLE_CACHE_DAYS=7
CONTEXT7_CACHE_DAYS=30
HTTP_TIMEOUT=20

# ---------------------------------------------------------------------------
# Response size (tuned on NodeGoat's SAST findings to limit LLM attention dilution:
# 3 sections of up to 800 chars covered as much key fix advice as larger budgets)
# ---------------------------------------------------------------------------

# Upper limit on the characters of prompt context per request (one file).
DEFAULT_MAX_CHARS=2500

# Each returned cheat-sheet section / Context7 note is trimmed to this many characters.
PASSAGE_MAX_CHARS=800

# Cheat-sheet sections returned per distinct finding.
GUIDANCE_TOP_K=3

# Minimum similarity (0–1) for a section to count as relevant.
MIN_SIMILARITY=0.35

# Context7 breaking-change notes per request (major upgrades only).
MAX_LIBRARY_NOTES=2
# Those notes describe an upgrade that is held back for a person, so they go to the references
# (PR / issue). true also puts them into the LLM prompt.
LIBRARY_NOTES_IN_PROMPT=false
# Container images: the prompt says whether a compatible fix exists. The list of newer release
# lines and the migration target are in the upgrade data for the PR; true also puts them
# into the LLM prompt.
IMAGE_LINES_IN_PROMPT=false

# Keyword fallback of the OWASP search: when a finding's best similarity score is below
# KEYWORD_FALLBACK_BELOW, its lowest-ranked sections are replaced by this many keyword matches
# (the answer does not grow). 0 results switches the fallback off.
KEYWORD_FALLBACK_BELOW=0.62
KEYWORD_FALLBACK_RESULTS=2

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
# Comma-separated sources to answer without, for every request. Ids: cwe, owasp, nvd, kev, osv,
# context7, dockerhub, endoflife (and "keyword" for the keyword fallback).
# Example: DISABLED_SOURCES=dockerhub,endoflife
DISABLED_SOURCES=
