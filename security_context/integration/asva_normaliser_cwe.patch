+++ b/tests/unit/test_normaliser.py
@@ -62,6 +62,16 @@ def test_extract_cwe_empty_list_returns_none():
     assert extract_cwe({"cwe": []}) is None
 
 
+def test_extract_cwe_falls_back_to_the_rule_tags():
+    # Snyk Open Source and Snyk Container put the CWE among the rule's tags
+    assert extract_cwe({"tags": ["security", "CWE-79", "npm"]}) == "CWE-79"
+    assert extract_cwe({"tags": ["security", "deb"]}) is None
+
+
+def test_extract_cwe_prefers_the_cwe_field_over_the_tags():
+    assert extract_cwe({"cwe": ["CWE-94"], "tags": ["CWE-79"]}) == "CWE-94"
+
