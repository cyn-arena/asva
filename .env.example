# Copy this file to `.env` and fill in values. `.env` is gitignored — never commit it.

# --- GitOps (task 3.5, native git + gh) ---

# Integration branch ASVA opens fix PRs into for human review. ASVA never auto-merges.
GITHUB_BASE_BRANCH=feat/agent

# Maps app-relative finding paths (e.g. app/routes/x.js) to their location in the repo.
# The NodeGoat target lives under target-apps/NodeGoat, so set that prefix when fixing it.
ASVA_FIX_PATH_PREFIX=target-apps/NodeGoat

# Optional explicit owner/repo for `gh`. Leave blank to auto-detect from the checkout.
GITHUB_TARGET_REPO=

# Committer identity for fix commits.
ASVA_GIT_NAME=asva-bot
ASVA_GIT_EMAIL=asva-bot@users.noreply.github.com

# Auth — LOCAL dev only: run `gh auth login` once (and `gh auth setup-git` for push).
# In CI this is provided by the workflow's GITHUB_TOKEN (GH_TOKEN env) — nothing to set here.
# GH_TOKEN=

# --- Secrets-scan gate (task 3.6, git-leaks) ---

# PATH name or absolute path to the gitleaks binary (install via scripts/install-gitleaks.*).
GITLEAKS_BINARY=gitleaks

# gitleaks subcommand: "detect" (universal) or "dir" (newer gitleaks releases).
GITLEAKS_SUBCOMMAND=detect

# Needed only for `pytest -m rescan`; every other tier skips without these.

# PATH name or absolute path to the snyk binary (install via scripts/install-snyk.*).
SNYK_BINARY=snyk

# Auth — LOCAL dev only: run `snyk auth` once (opens a browser, stores its own token in the
# CLI's local config — nothing to paste here). In CI, set SNYK_TOKEN instead (repo secret).
# SNYK_TOKEN=
SNYK_ORG=

# Patched NodeGoat checkout to compare against RESCAN_BEFORE_DIR (defaults to this repo's
# target-apps/NodeGoat). No sensible default — e.g. a worktree with fix branches applied.
RESCAN_BEFORE_DIR=
RESCAN_AFTER_DIR=

# --- LLM backend (llm/llm_client.py, Ollama) ---
# Needed only for a real end-to-end agent run; unit/e2e tests mock call_llm.
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=
# Optional: the model's context window in tokens, e.g. 32768. The OpenAI-style endpoint
# cannot set it per call, so set it to the window the server uses. The agent warns when a
# prompt + reply may not fit (ITP2 3.6 multi-file prompts).
OLLAMA_NUM_CTX=
# Optional: reply cap in tokens, sent as max_tokens (CI uses 16384). Unset = server default.
# A full rewrite of a large file (PyGoat introduction/views.py ~12k tokens) needs >8192.
ASVA_LLM_NUM_PREDICT=
# Optional, for reasoning ("thinking") models such as glm-5.3-flash: their hidden reasoning
# counts against ASVA_LLM_NUM_PREDICT and can use it all before any code is written (the
# log then shows reasoning_chars>0, answer_chars=0). Tell the endpoint to think less:
#   ASVA_LLM_REASONING_EFFORT=none   (sent as "reasoning_effort"; or low/medium/high)
#   ASVA_LLM_EXTRA_BODY={"think": false}   (any JSON merged into the request body)
ASVA_LLM_REASONING_EFFORT=
ASVA_LLM_EXTRA_BODY=
# Optional: replies are streamed by default, so a long reply is not cut off by the gateway's
# limit on silent requests (Cloudflare 524); 0 turns streaming off.
# Retries: OLLAMA_RETRIES (3), OLLAMA_RETRY_DELAY (15s).
OLLAMA_STREAM=
# Optional: target-app language for prompts ("node" or "python"). Detected from the app
# folder ASVA_FIX_PATH_PREFIX points at when unset (target-apps/PyGoat -> python).
ASVA_APP_LANGUAGE=
# Optional: 0 turns off repo-aware context (3.1), same as --no-repo-context.
ASVA_REPO_CONTEXT=
# Optional: folder for the interactive import map of the repo-context index (one HTML per
# batch), same as --import-map-dir. Dry runs default to <output-dir>/import_maps.
ASVA_IMPORT_MAP_DIR=
